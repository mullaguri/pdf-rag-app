EMBEDDING_MODEL="Enter your value here"

# Vector Store Configuration
# FAISS (Local)
# VECTOR_STORE_PATH=./vectorstore/faiss_index

# Pinecone (Cloud)
PINECONE_API_KEY="Enter your Pinecone API key here"
PINECONE_ENVIRONMENT="us-west1-gcp-free"
PINECONE_INDEX_NAME="pdf-rag-index"
PINECONE_PROJECT_ID="pdf-rag-app"

# Embedding Configuration
# EMBEDDING_PROVIDER=""  # Optional: "openai", "cohere", "ollama", "huggingface" (auto-detect if empty)
# HuggingFace MiniLM-L6-v2: 384 dimensions
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Alternative Embedding Models (uncomment to use)
# OpenAI text-embedding-3-small: 1536 dimensions
# EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_DIMENSION=1536

# Cohere embed-multilingual-v3.0: 1024 dimensions  
# EMBEDDING_MODEL="embed-multilingual-v3.0"
# EMBEDDING_DIMENSION=1024

# Database URL
# SQLALCHEMY_DATABASE_URL="sqlite:///./app.db"  # For SQLite
SQLALCHEMY_DATABASE_URL="Enter your value here"

# JWT Settings
SECRET_KEY="Enter your value here"
ALGORITHM="Enter your value here"
ACCESS_TOKEN_EXPIRE_MINUTES="Enter your value here"
REFRESH_TOKEN_EXPIRE_DAYS="Enter your value here"
